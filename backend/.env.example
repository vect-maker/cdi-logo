# ==============================================================================
# ICD Logo Voting Platform — Backend Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env

# --- Application Settings ---
PROJECT_NAME="ICD Logo Voting Backend"
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000

# Allowed CORS Origins (must be a valid JSON array of URL strings)
CORS_ORIGINS='["http://localhost:5173", "http://localhost:4173", "http://127.0.0.1:5173"]'

# --- Turso Cloud Database Settings (Production / Cloud) ---
# When deployed to production (e.g., Render, Railway, Fly), set your Turso credentials.
# The backend connects directly to your cloud Turso database over HTTPS/libSQL (pure remote mode).
# No local database file or volume is needed!
# TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# Optional: Set to true only if you want an embedded local replica synced with Turso
# TURSO_EMBEDDED_REPLICA=false

# --- Local SQLite Database File Path (Local Dev Fallback) ---
# Used ONLY when TURSO_DATABASE_URL is not set (falls back to local SQLite)
LOCAL_DB_PATH="voting.db"
