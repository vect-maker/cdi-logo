# ==========================================
# ICD Identity & Voting Platform .gitignore
# ==========================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editors & IDEs
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*.swn
*~
*.bak

# Python Bytecode & Environments
__pycache__/
*.py[cod]
*$py.class
*.sqlite3
*.db
.Python
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python Build & Test
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node & Frontend
node_modules/
dist/
dist-ssr/
*.local
.env*.local
.vite/
cypress/videos/
cypress/screenshots/
cypress/downloads/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Transient Pipeline Renders
renders/*
!renders/.gitignore
